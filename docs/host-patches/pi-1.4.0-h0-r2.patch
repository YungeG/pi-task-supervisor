+import { createHash, randomUUID } from "node:crypto";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { AgentSessionRuntime } from "../src/core/agent-session-runtime.ts";
+import type { BashOperations } from "../src/core/tools/bash.ts";
+import { runRpcMode } from "../src/modes/rpc/rpc-mode.ts";
+import { createHarness, type Harness } from "./suite/harness.ts";
+
+const rpcIo = vi.hoisted(() => ({
+	lines: [] as string[],
+	send: undefined as ((line: string) => void) | undefined,
+}));
+vi.mock("../src/core/output-guard.js", () => ({
+	flushRawStdout: vi.fn(async () => {}),
+	takeOverStdout: vi.fn(),
+	waitForRawStdoutBackpressure: vi.fn(async () => {}),
+	writeRawStdout: (line: string) => {
+		rpcIo.lines.push(line);
+	},
+}));
+vi.mock("../src/modes/rpc/jsonl.js", () => ({
+	attachJsonlLineReader: (_stream: unknown, onLine: (line: string) => void) => {
+		rpcIo.send = onLine;
+		return () => {
+			rpcIo.send = undefined;
+		};
+	},
+	serializeJsonLine: (value: unknown) => `${JSON.stringify(value)}\n`,
+}));
+
+function gate() {
+	let resolve!: () => void;
+	const promise = new Promise<void>((done) => {
+		resolve = done;
+	});
+	return { promise, resolve };
+}
+const binding = createHash("sha256").update("rpc-idle-test").digest("hex");
+
+describe("RPC idle action input wiring", () => {
+	const harnesses: Harness[] = [];
+	const signals: NodeJS.Signals[] = process.platform === "win32" ? ["SIGTERM"] : ["SIGTERM", "SIGHUP"];
+	const originalEnd = process.stdin.listeners("end");
+	const originalSignals = new Map(signals.map((signal) => [signal, process.listeners(signal)]));
+	afterEach(() => {
+		for (const harness of harnesses.splice(0)) harness.cleanup();
+		for (const listener of process.stdin.listeners("end") as Array<Parameters<typeof process.on>[1]>) {
+			if (!originalEnd.includes(listener)) process.stdin.off("end", listener);
+		}
+		for (const signal of signals) {
+			for (const listener of process.listeners(signal) as Array<Parameters<typeof process.on>[1]>) {
+				if (!originalSignals.get(signal)!.includes(listener)) process.off(signal, listener);
+			}
+		}
+		rpcIo.lines = [];
+		rpcIo.send = undefined;
+	});
+
+	it.each(["select", "confirm", "input", "editor", "custom"] as const)(
+		"fails closed for leased %s UI without changing ordinary RPC dialogs",
+		async (method) => {
+			const harness = await createHarness();
+			harnesses.push(harness);
+			void runRpcMode({ session: harness.session, setRebindSession: () => {} } as unknown as AgentSessionRuntime);
+			await vi.waitFor(() => expect(rpcIo.send).toBeDefined());
+			const ordinary = harness.session.extensionRunner.createContext();
+			const handle = ordinary.idleActions!.request({
+				id: randomUUID(),
+				binding,
+				isCurrent: () => true,
+				run: async (lease) => {
+					const ui = lease.context.ui;
+					switch (method) {
+						case "select":
+							await ui.select("leased", ["Later"], { signal: lease.signal });
+							break;
+						case "confirm":
+							await ui.confirm("leased", "No RPC close acknowledgement", { signal: lease.signal });
+							break;
+						case "input":
+							await ui.input("leased", "text", { signal: lease.signal });
+							break;
+						case "editor":
+							await ui.editor("leased", "text");
+							break;
+						case "custom":
+							await ui.custom(() => ({ render: () => [], invalidate: () => {} }));
+							break;
+					}
+				},
+			});
+			const uiRequests = () =>
+				rpcIo.lines
+					.map((line) => JSON.parse(line) as { type: string; method?: string; id: string })
+					.filter((message) => message.type === "extension_ui_request");
+			try {
+				expect(uiRequests()).toEqual([]);
+				await handle.result;
+			} finally {
+				// Release the pre-fix RPC editor too; it does not support an abort signal.
+				for (const message of uiRequests())
+					rpcIo.send!(JSON.stringify({ type: "extension_ui_response", id: message.id, cancelled: true }));
+				handle.cancel();
+				await handle.result;
+			}
+			expect(await handle.result).toMatchObject({ status: "failed", reason: "callback_error" });
+			expect(ordinary.hasUI).toBe(true);
+			const dialog = ordinary.ui.select("ordinary", ["Later"]);
+			const request = uiRequests().findLast((message) => message.method === "select")!;
+			rpcIo.send!(JSON.stringify({ type: "extension_ui_response", id: request.id, value: "Later" }));
+			expect(await dialog).toBe("Later");
+		},
+	);
+
+	it.each(["result", "operations"] as const)(
+		"keeps the whole %s interception and recording before an action",
+		async (kind) => {
+			const intercepted = gate();
+			const release = gate();
+			const operations: BashOperations = { exec: async () => ({ exitCode: 0 }) };
+			const result = { output: "rpc intercepted", exitCode: 0, cancelled: false, truncated: false };
+			const harness = await createHarness({
+				extensionFactories: [
+					(pi) => {
+						pi.on("user_bash", async () => {
+							intercepted.resolve();
+							await release.promise;
+							return kind === "result" ? { result } : { operations };
+						});
+					},
+				],
+			});
+			harnesses.push(harness);
+			const replacement = await createHarness();
+			harnesses.push(replacement);
+			const host = {
+				session: harness.session,
+				setRebindSession: () => {},
+				newSession: async () => {
+					host.session = replacement.session;
+					return { cancelled: false };
+				},
+			};
+			void runRpcMode(host as unknown as AgentSessionRuntime);
+			await vi.waitFor(() => expect(rpcIo.send).toBeDefined());
+			rpcIo.send!(JSON.stringify({ id: "bash", type: "bash", command: "pwd" }));
+			await intercepted.promise;
+			let entered = false;
+			const api = harness.session.extensionRunner.createContext().idleActions!;
+			const handle = api.request({
+				id: randomUUID(),
+				binding,
+				isCurrent: () => true,
+				run: async () => {
+					entered = true;
+				},
+			});
+			try {
+				expect(entered).toBe(false);
+				expect(api.state().pendingInputs).toBeGreaterThan(0);
+			} finally {
+				rpcIo.send!(JSON.stringify({ id: "replacement", type: "new_session" }));
+				await vi.waitFor(() =>
+					expect(rpcIo.lines.some((line) => (JSON.parse(line) as { id?: string }).id === "replacement")).toBe(
+						true,
+					),
+				);
+				release.resolve();
+				await vi.waitFor(() =>
+					expect(
+						rpcIo.lines.some((line) => {
+							const message = JSON.parse(line) as { type: string; command?: string; success?: boolean };
+							return message.type === "response" && message.command === "bash" && message.success;
+						}),
+					).toBe(true),
+				);
+				await handle.result;
+			}
+			expect(entered).toBe(false);
+			expect(harness.session.messages.filter((message) => message.role === "bashExecution")).toHaveLength(1);
+			expect(replacement.session.messages.filter((message) => message.role === "bashExecution")).toHaveLength(0);
+		},
+	);
+});
