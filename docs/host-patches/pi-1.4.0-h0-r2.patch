+import { AsyncLocalStorage } from "node:async_hooks";
+import { createHash, randomUUID } from "node:crypto";
+import { fauxAssistantMessage } from "@earendil-works/pi-ai";
+import { afterEach, describe, expect, it } from "vitest";
+import { createEventBus } from "../../src/core/event-bus.ts";
+import type {
+	ExtensionAPI,
+	ExtensionContext,
+	IdleActionAPI,
+	IdleActionHandle,
+	IdleActionResult,
+} from "../../src/core/extensions/index.ts";
+import { createExtensionRuntime, loadExtensionFromFactory } from "../../src/core/extensions/loader.ts";
+import { createHarness, createTestUiContext, type Harness } from "./harness.ts";
+
+function gate() {
+	let resolve!: () => void;
+	const promise = new Promise<void>((done) => {
+		resolve = done;
+	});
+	return { promise, resolve };
+}
+
+const binding = createHash("sha256").update("idle-action-sentinel").digest("hex");
+
+describe("AgentSession idle actions", () => {
+	const harnesses: Harness[] = [];
+	afterEach(() => {
+		for (const harness of harnesses.splice(0)) harness.cleanup();
+	});
+
+	it("keeps hasUI false for absent UI, including explicit reset after a real UI", async () => {
+		const harness = await createHarness();
+		harnesses.push(harness);
+		const runner = harness.session.extensionRunner;
+		expect(runner.createContext().hasUI).toBe(false);
+		runner.setUIContext(undefined);
+		expect(runner.createContext().hasUI).toBe(false);
+		for (const mode of ["tui", "rpc"] as const) {
+			runner.setUIContext(createTestUiContext(), mode);
+			expect(runner.createContext().hasUI).toBe(true);
+			runner.setUIContext(undefined, "print");
+			expect(runner.createContext().hasUI).toBe(false);
+		}
+	});
+
+	it.each(["session", "error"] as const)(
+		"keeps competing input from a %s observer outside the action marker",
+		async (kind) => {
+			let pi!: ExtensionAPI;
+			const own = new AsyncLocalStorage<string>();
+			const stores: Array<string | undefined> = [];
+			const input = gate();
+			const settled = gate();
+			const release = gate();
+			let cleanup = false;
+			let observerError: unknown;
+			const harness = await createHarness({
+				extensionFactories: [
+					(api) => {
+						pi = api;
+						api.on("input", (event) => {
+							if (event.text === "observer input") {
+								stores.push(own.getStore());
+								input.resolve();
+							}
+						});
+					},
+				],
+			});
+			harnesses.push(harness);
+			harness.setResponses([fauxAssistantMessage("observer input done")]);
+			harness.session.subscribe((event) => {
+				if (event.type === "agent_settled") settled.resolve();
+			});
+			const observe = () => {
+				stores.push(own.getStore());
+				try {
+					pi.sendUserMessage("observer input");
+				} catch (error) {
+					observerError = error;
+				}
+			};
+			if (kind === "session")
+				harness.session.subscribe((event) => {
+					if (
+						event.type === "entry_appended" &&
+						event.entry.type === "custom" &&
+						event.entry.customType === "h0-observed"
+					)
+						observe();
+				});
