@@ -0,0 +1,210 @@
+import { createHash, randomUUID } from "node:crypto";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { ExtensionContext, ExtensionRunner, IdleActionResult } from "../src/core/extensions/index.ts";
+import type { BashOperations } from "../src/core/tools/bash.ts";
+import { InteractiveMode } from "../src/modes/interactive/interactive-mode.ts";
+import { createHarness, createTestUiContext, type Harness } from "./suite/harness.ts";
+
+vi.mock("../src/modes/interactive/components/bash-execution.js", () => ({
+	BashExecutionComponent: class {
+		appendOutput(): void {}
+		setComplete(): void {}
+	},
+}));
+
+function gate() {
+	let resolve!: () => void;
+	const promise = new Promise<void>((done) => {
+		resolve = done;
+	});
+	return { promise, resolve };
+}
+const binding = createHash("sha256").update("mode-idle-test").digest("hex");
+
+interface ModeInput {
+	defaultEditor: {
+		onSubmit?: (text: string) => Promise<void> | void;
+		onExtensionShortcut?: (data: string) => boolean;
+	};
+	setupEditorSubmitHandler(): void;
+	setupExtensionShortcuts(runner: ExtensionRunner): void;
+}
+
+function modeInput(harness: Harness): ModeInput {
+	const context = {
+		defaultEditor: {},
+		editor: { addToHistory: vi.fn() },
+		session: harness.session,
+		sessionManager: harness.sessionManager,
+		settingsManager: harness.settingsManager,
+		keybindings: { getEffectiveConfig: () => ({}) },
+		ui: { requestRender: vi.fn() },
+		chatContainer: { addChild: vi.fn() },
+		pendingMessagesContainer: { addChild: vi.fn() },
+		pendingBashComponents: [],
+		isBashMode: true,
+		showError: vi.fn(),
+		updateEditorBorderColor: vi.fn(),
+	};
+	return new Proxy(context, {
+		get(target, key, receiver) {
+			if (key in target) return Reflect.get(target, key, receiver);
+			const value: unknown = Reflect.get(InteractiveMode.prototype, key, receiver);
+			return typeof value === "function" ? value.bind(receiver) : value;
+		},
+	}) as unknown as ModeInput;
+}
+
+describe("InteractiveMode idle action entry wiring", () => {
+	const harnesses: Harness[] = [];
+	afterEach(() => {
+		for (const harness of harnesses.splice(0)) harness.cleanup();
+	});
+
+	it("gives a real extension shortcut a guarded action context without blocking its awaited result", async () => {
+		const finished = gate();
+		let saved: ExtensionContext | undefined;
+		let outcome: IdleActionResult | undefined;
+		const harness = await createHarness({
+			extensionFactories: [
+				(pi) => {
+					pi.registerShortcut("ctrl+shift+y", {
+						handler: async (ctx) => {
+							saved = ctx;
+							outcome = await ctx.idleActions?.request({
+								id: randomUUID(),
+								binding,
+								isCurrent: () => true,
+								run: async () => {},
+							}).result;
+							finished.resolve();
+						},
+					});
+				},
+			],
+		});
+		harnesses.push(harness);
+		await harness.session.bindExtensions({ mode: "tui", uiContext: createTestUiContext() });
+		const mode = modeInput(harness);
+		mode.setupExtensionShortcuts(harness.session.extensionRunner);
+		expect(mode.defaultEditor.onExtensionShortcut?.("\x1b[121;6u")).toBe(true);
+		await finished.promise;
+		expect(saved?.idleActions?.version).toBe(1);
+		expect(outcome).toMatchObject({ status: "completed" });
+		const select = saved!.ui.select;
+		await harness.session.reload();
+		expect(() => saved!.idleActions).toThrow(/stale/);
+		expect(() => select("old context", ["Later"])).toThrow(/stale/);
+	});
+
+	it("cancels and joins an owned action before a delayed real shortcut opens ordinary UI", async () => {
+		const shortcutWaiting = gate();
+		const releaseShortcut = gate();
+		const shortcutDone = gate();
+		const ownedOpen = gate();
+		const ownedClose = gate();
+		const titles: string[] = [];
+		const harness = await createHarness({
+			extensionFactories: [
+				(pi) => {
+					pi.registerShortcut("ctrl+shift+y", {
+						handler: async (ctx) => {
+							shortcutWaiting.resolve();
+							await releaseShortcut.promise;
+							await ctx.ui.select("foreign shortcut", ["Later"]);
+							shortcutDone.resolve();
+						},
+					});
+				},
+			],
+		});
+		harnesses.push(harness);
+		await harness.session.bindExtensions({
+			mode: "tui",
+			uiContext: createTestUiContext({
+				select: async (title, _options, opts) => {
+					titles.push(title);
+					if (title === "owned") {
+						ownedOpen.resolve();
+						await new Promise<void>((resolve) =>
+							opts?.signal?.addEventListener("abort", () => resolve(), { once: true }),
+						);
+						await ownedClose.promise;
+					}
+					return undefined;
+				},
+			}),
+		});
+		const mode = modeInput(harness);
+		mode.setupExtensionShortcuts(harness.session.extensionRunner);
+		mode.defaultEditor.onExtensionShortcut!("\x1b[121;6u");
+		await shortcutWaiting.promise;
+		const handle = harness.session.extensionRunner.createContext().idleActions!.request({
+			id: randomUUID(),
+			binding,
+			isCurrent: () => true,
+			run: async (lease) => {
+				await lease.context.ui.select("owned", ["Later"], { signal: lease.signal });
+			},
+		});
+		await ownedOpen.promise;
+		releaseShortcut.resolve();
+		await new Promise<void>((resolve) => handle.signal.addEventListener("abort", () => resolve(), { once: true }));
+		expect(titles).toEqual(["owned"]);
+		ownedClose.resolve();
+		await shortcutDone.promise;
+		expect(await handle.result).toMatchObject({ status: "cancelled", reason: "input" });
+		expect(titles).toEqual(["owned", "foreign shortcut"]);
+	});
+
+	it.each(["result", "operations"] as const)(
+		"keeps the whole %s bash input ahead of a pending action",
+		async (kind) => {
+			const intercepted = gate();
+			const release = gate();
+			const operations: BashOperations = { exec: async () => ({ exitCode: 0 }) };
+			const result = { output: "intercepted", exitCode: 0, cancelled: false, truncated: false };
+			const harness = await createHarness({
+				extensionFactories: [
+					(pi) => {
+						pi.on("user_bash", async () => {
+							intercepted.resolve();
+							await release.promise;
+							return kind === "result" ? { result } : { operations };
+						});
+					},
+				],
+			});
+			harnesses.push(harness);
+			const mode = modeInput(harness);
+			mode.setupEditorSubmitHandler();
+			const bash = mode.defaultEditor.onSubmit?.("!pwd");
+			await intercepted.promise;
+			const replacement = await createHarness();
+			harnesses.push(replacement);
+			let entered = false;
+			const api = harness.session.extensionRunner.createContext().idleActions!;
+			const handle = api.request({
+				id: randomUUID(),
+				binding,
+				isCurrent: () => true,
+				run: async () => {
+					entered = true;
+				},
+			});
+			try {
+				expect(entered).toBe(false);
+				expect(api.state().pendingInputs).toBeGreaterThan(0);
+			} finally {
+				// A mode rebind during interception cannot move this input barrier or its result.
+				Object.assign(mode, { session: replacement.session, sessionManager: replacement.sessionManager });
+				release.resolve();
+				await bash;
+				await handle.result;
+			}
+			expect(entered).toBe(false);
+			expect(harness.session.messages.filter((message) => message.role === "bashExecution")).toHaveLength(1);
+			expect(replacement.session.messages.filter((message) => message.role === "bashExecution")).toHaveLength(0);
+		},
+	);
+});
