+import { AsyncLocalStorage } from "node:async_hooks";
+import type {
+	ExtensionContext,
+	IdleActionAPI,
+	IdleActionHandle,
+	IdleActionLease,
+	IdleActionReason,
+	IdleActionRequest,
+	IdleActionResult,
+	IdleActionState,
+} from "./extensions/types.ts";
+import type { CustomMessage } from "./messages.ts";
+
+type Delivery = Pick<CustomMessage, "customType" | "content" | "display" | "details">;
+type Started = Extract<IdleActionResult, { status: "started" }>;
+
+interface IdleActionHost {
+	state(): IdleActionState;
+	capture(): () => boolean;
+	context(signal: AbortSignal, owner: symbol, isCurrent: () => boolean): ExtensionContext;
+	start(actionId: string, message: Delivery, acknowledge: (result: Started) => void): void;
+}
+
+interface Attempt {
+	id: string;
+	request?: IdleActionRequest;
+	controller: AbortController;
+	owner: symbol;
+	epoch: number;
+	current: () => boolean;
+	handle: IdleActionHandle;
+	resolve: (result: IdleActionResult) => void;
+	phase: "pending" | "running" | "started";
+	reason?: IdleActionReason;
+	dispatched: boolean;
+	started?: Started;
+	delivery?: IdleActionResult;
+	cleanup?: Promise<void>;
+}
+
+/** One session-local, nonpersistent slot. It does not hold business approvals or replay intents. */
+export class IdleActionController {
+	private readonly host: IdleActionHost;
+	private readonly scope = new AsyncLocalStorage<Attempt>();
+	private readonly attempts = new Map<string, { binding: string; handle: IdleActionHandle }>();
+	private readonly activities = new Map<symbol | undefined, number>();
+	private readonly uiActivities = new Map<symbol | undefined, number>();
+	private readonly activityWaiters = new Set<() => void>();
+	private slot?: Attempt;
+	private epoch = 0;
+	private closed = false;
+	readonly api: IdleActionAPI;
+
+	constructor(host: IdleActionHost) {
+		this.host = host;
+		this.api = {
+			version: 1,
+			state: () => this.state(),
+			request: (request) => this.request(request),
+		};
+	}
+
+	state(): IdleActionState {
+		const state = this.host.state();
+		if (state.phase === "idle" && (this.closed || this.activities.size > 0)) state.phase = "busy";
+		if (this.slot) state.activeActionId = this.slot.id;
+		return state;
+	}
+
+	/** Exit only this controller's ALS; an extension's own ALS stores are untouched. */
+	outside<T>(run: () => T): T {
+		return this.scope.exit(run);
+	}
+
+	assertOutsideAction(): void {
+		const attempt = this.scope.getStore();
+		if (!attempt) return;
+		if (this.slot === attempt) this.cancel(attempt, "callback_error");
+		throw new Error("Idle action callbacks must use lease.dispatch(), not ordinary input/control APIs");
+	}
+
+	/** Called synchronously before an input or native control changes state. */
+	invalidate(reason: IdleActionReason): Promise<void> | undefined {
+		this.epoch++;
+		const attempt = this.slot;
+		if (!attempt || attempt.phase === "started") return;
+		this.cancel(attempt, reason);
+		return attempt.cleanup;
+	}
+
+	dispose(): void {
+		this.closed = true;
+		this.invalidate("stale");
+	}
+
+	activity(owner?: symbol, kind: "event" | "ui" = "event"): () => void {
+		this.activities.set(owner, (this.activities.get(owner) ?? 0) + 1);
+		if (kind === "ui") this.uiActivities.set(owner, (this.uiActivities.get(owner) ?? 0) + 1);
+		const attempt = this.slot;
+		if (attempt?.phase === "running" && owner !== attempt.owner) this.invalidate("input");
+		let finished = false;
+		return () => {
+			if (finished) return;
+			finished = true;
+			for (const counts of kind === "ui" ? [this.activities, this.uiActivities] : [this.activities]) {
+				const count = (counts.get(owner) ?? 1) - 1;
+				if (count === 0) counts.delete(owner);
+				else counts.set(owner, count);
+			}
+			for (const wake of [...this.activityWaiters]) wake();
+			this.pump();
+		};
+	}
+
+	beforeUI(owner?: symbol): Promise<void> | undefined {
+		const attempt = this.slot;
+		if (owner !== undefined) {
+			if (!attempt || owner !== attempt.owner || !this.isCurrent(attempt)) {
+				throw new Error("This idle action UI is stale");
+			}
+			return;
+		}
+		this.assertOutsideAction();
+		if (attempt?.phase === "running") {
+			this.cancel(attempt, "input");
+			return attempt.cleanup;
+		}
+	}
+
+	private rejected(id: string, reason: IdleActionReason): IdleActionHandle {
+		const controller = new AbortController();
+		controller.abort();
+		return {
+			id,
+			signal: controller.signal,
+			result: Promise.resolve({ status: "rejected", actionId: id, reason }),
+			cancel: () => {},
+		};
+	}
+
+	private request(request: IdleActionRequest): IdleActionHandle {
+		const id = typeof request?.id === "string" ? request.id : "";
+		if (
+			!/^[\da-f]{8}-[\da-f]{4}-[1-8][\da-f]{3}-[89ab][\da-f]{3}-[\da-f]{12}$/i.test(id) ||
+			typeof request.binding !== "string" ||
+			!/^[\da-f]{64}$/.test(request.binding) ||
+			typeof request.isCurrent !== "function" ||
+			typeof request.run !== "function"
+		)
+			return this.rejected(id.slice(0, 128), "invalid_request");
+		const previous = this.attempts.get(id);
+		if (previous) {
+			return previous.binding === request.binding ? previous.handle : this.rejected(id, "conflict");
+		}
+		if (this.attempts.size >= 4096) return this.rejected(id, "capacity");
+		if (this.closed || this.slot) {
+			const handle = this.rejected(id, this.closed ? "unavailable" : "busy");
+			this.attempts.set(id, { binding: request.binding, handle });
+			return handle;
+		}
+		const controller = new AbortController();
+		let resolve!: (result: IdleActionResult) => void;
+		const result = new Promise<IdleActionResult>((done) => {
+			resolve = done;
+		});
+		const handle: IdleActionHandle = {
+			id,
+			signal: controller.signal,
+			result,
+			cancel: () => {
+				if (this.slot?.id === id) this.cancel(this.slot, "abort");
+			},
+		};
+		this.attempts.set(id, { binding: request.binding, handle });
+		this.slot = {
+			id,
+			request: { ...request },
+			controller,
+			owner: Symbol(id),
+			epoch: this.epoch,
+			current: this.host.capture(),
+			handle,
+			resolve,
+			phase: "pending",
+			dispatched: false,
+		};
+		this.pump();
+		return handle;
+	}
+
+	private outcome(attempt: Attempt): IdleActionResult {
+		return (
+			attempt.started ?? {
+				status: attempt.reason === "callback_error" ? "failed" : "cancelled",
+				actionId: attempt.id,
+				reason: attempt.reason ?? "stale",
+			}
+		);
+	}
+
+	private cancel(attempt: Attempt, reason: IdleActionReason): void {
+		if (attempt.phase === "started" || attempt.reason) return;
+		attempt.reason = reason;
+		attempt.controller.abort();
+		if (attempt.phase === "pending") {
+			attempt.resolve(this.outcome(attempt));
+			attempt.request = undefined;
+			if (this.slot === attempt) this.slot = undefined;
+		}
+	}
+
+	private isCurrent(attempt: Attempt): boolean {
+		if (this.closed || this.slot !== attempt || attempt.phase === "started" || attempt.controller.signal.aborted)
+			return false;
+		if (attempt.epoch !== this.epoch) return false;
+		try {
+			const valid =
+				attempt.current() && !!attempt.request && this.scope.run(attempt, attempt.request.isCurrent) === true;
+			// Even a read-only predicate can reenter cancellation. Never accept its late true.
+			return (
+				valid &&
+				!this.closed &&
+				this.slot === attempt &&
+				!attempt.controller.signal.aborted &&
+				attempt.epoch === this.epoch
+			);
+		} catch {
+			return false;
+		}
+	}
+
+	private qualified(attempt: Attempt): boolean {
+		if (!this.isCurrent(attempt)) return false;
+		const state = this.host.state();
+		return (
+			state.phase === "idle" &&
+			state.pendingInputs === 0 &&
+			[...this.activities.keys()].every((owner) => owner === attempt.owner)
+		);
+	}
+
+	/** Invoked by explicit lifecycle/activity/input exits, never by idle polling. */
+	pump(): void {
+		const attempt = this.slot;
+		if (!attempt || attempt.phase !== "pending") return;
+		if (!this.isCurrent(attempt)) {
+			this.cancel(attempt, "stale");
+			return;
+		}
+		if (!this.qualified(attempt)) return;
+		attempt.phase = "running";
+		let finish!: () => void;
+		attempt.cleanup = new Promise<void>((resolve) => {
+			finish = resolve;
+		});
+		void this.scope.run(attempt, async () => {
+			let outcome: IdleActionResult;
+			try {
+				const lease: IdleActionLease = {
+					id: attempt.id,
+					signal: attempt.controller.signal,
+					context: this.host.context(attempt.controller.signal, attempt.owner, () => this.qualified(attempt)),
+					isCurrent: () => this.qualified(attempt),
+					dispatch: async (message, validate) => {
+						const first = !attempt.dispatched;
+						const result = await this.dispatch(attempt, message, validate);
+						if (first) attempt.delivery = result;
+						return result;
+					},
+				};
+				await attempt.request?.run(lease);
+				outcome =
+					attempt.started ??
+					(attempt.reason
+						? this.outcome(attempt)
+						: (attempt.delivery ?? {
+								status: attempt.dispatched ? "failed" : "completed",
+								actionId: attempt.id,
+								...(attempt.dispatched ? { reason: "callback_error" as const } : {}),
+							}));
+			} catch {
+				outcome =
+					attempt.started ??
+					(attempt.reason
+						? this.outcome(attempt)
+						: (attempt.delivery ?? {
+								status: "failed",
+								actionId: attempt.id,
+								reason: "callback_error",
+							}));
+			} finally {
+				attempt.request = undefined;
+				attempt.controller.abort();
+				// A callback returning is not proof that its fire-and-forget dialog has closed.
+				// Do not join foreign activity here: it may itself be waiting for this cleanup.
+				if (this.uiActivities.has(attempt.owner))
+					await new Promise<void>((resolve) => {
+						const closed = () => {
+							if (!this.uiActivities.has(attempt.owner)) {
+								this.activityWaiters.delete(closed);
+								resolve();
+							}
+						};
+						this.activityWaiters.add(closed);
+						closed();
+					});
+				if (this.slot === attempt) this.slot = undefined;
+				finish();
+				this.pump();
+			}
+			attempt.resolve(attempt.started ?? (attempt.reason ? this.outcome(attempt) : outcome));
+		});
+	}
+
+	private async dispatch(
+		attempt: Attempt,
+		message: Delivery,
+		validate: () => boolean | Promise<boolean>,
+	): Promise<IdleActionResult> {
+		if (attempt.dispatched) return { status: "rejected", actionId: attempt.id, reason: "conflict" };
+		attempt.dispatched = true;
+		if (!this.qualified(attempt)) return this.outcome(attempt);
+		if (this.uiActivities.size > 0) return { status: "rejected", actionId: attempt.id, reason: "busy" };
+		let payload: Delivery;
+		try {
+			payload = structuredClone(message);
+		} catch {
+			return { status: "rejected", actionId: attempt.id, reason: "invalid_request" };
+		}
+		let delivering = false;
+		try {
+			// A UI's queued end observers must finish too, after its actual dialog has closed.
+			if (this.activities.size > 0) {
+				await this.cancellable(
+					attempt,
+					new Promise<void>((resolve) => {
+						const wake = () => {
+							if (this.activities.size === 0 || attempt.controller.signal.aborted) {
+								this.activityWaiters.delete(wake);
+								resolve();
+							}
+						};
+						this.activityWaiters.add(wake);
+						attempt.controller.signal.addEventListener("abort", wake, { once: true });
+						wake();
+					}),
+				);
+			}
+			if (!this.qualified(attempt)) return this.outcome(attempt);
+			const valid = await this.cancellable(attempt, Promise.resolve(this.scope.run(attempt, validate)));
+			if (!this.qualified(attempt)) return this.outcome(attempt);
+			if (valid !== true) return { status: "rejected", actionId: attempt.id, reason: "validation" };
+			// No await between this final qualification and the host's synchronous busy/ACK write.
+			delivering = true;
+			this.outside(() =>
+				this.host.start(attempt.id, payload, (result) => {
+					attempt.phase = "started";
+					attempt.started = result;
+					attempt.resolve(result);
+				}),
+			);
+			return attempt.started ?? { status: "unknown", actionId: attempt.id, reason: "dispatch_unknown" };
+		} catch {
+			return (
+				attempt.started ??
+				(attempt.reason
+					? this.outcome(attempt)
+					: delivering
+						? { status: "unknown", actionId: attempt.id, reason: "dispatch_unknown" }
+						: { status: "failed", actionId: attempt.id, reason: "callback_error" })
+			);
+		}
+	}
+
+	private cancellable<T>(attempt: Attempt, promise: Promise<T>): Promise<T | undefined> {
+		const signal = attempt.controller.signal;
+		return new Promise((resolve, reject) => {
+			const abort = () => {
+				resolve(undefined);
+			};
+			signal.addEventListener("abort", abort, { once: true });
+			if (signal.aborted) abort();
+			promise.then(resolve, reject).finally(() => signal.removeEventListener("abort", abort));
+		});
+	}
+}
