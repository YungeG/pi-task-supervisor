{
  "name": "continuous-tasks-local",
  "version": "0.1.0-local.0",
  "private": true,
  "description": "Session-scoped continuous execution with phased tasks, settled continuation, and evidence gates",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "main": "src/index.ts",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src/**/*.ts",
    "!src/__tests__/**",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "CANARY.md",
    "LICENSE",
    "LICENSE.upstream",
    "UPSTREAM.md"
  ],
  "scripts": {
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node test/real-pi-smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run test:smoke",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint --fix src/"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typebox": "1.3.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "author": "harms-haus; local fork maintained by ygguo",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
